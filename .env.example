# Supabase Client Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Connection (Supabase Transaction Pooler)
# IMPORTANT: Use the Transaction Pooler string on Port 6543 (NOT direct port 5432 or session pooler)
# to prevent connection exhaustion in serverless environments like Vercel.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Upstash Redis & Rate Limiting
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

